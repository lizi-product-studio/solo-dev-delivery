{
  "format": "delivery-contract/1",
  "owner": "agent-runtime",
  "candidate": "synthetic-procurement-v1",
  "authorization_ref": "user-requested-local-domain-evaluation",
  "scope": [
    "draft.json",
    "draft.txt"
  ],
  "excluded": [
    "external writes",
    "production operations"
  ],
  "inputs": [
    "TASK.md",
    "policy.json",
    "request.json"
  ],
  "policy": {
    "workspace_write": true,
    "shell_required": false,
    "external_actions": false,
    "ux_required": false
  },
  "budget": {
    "max_steps": 30,
    "max_retries": 2
  },
  "acceptance": [
    {
      "id": "draft-state",
      "expected": "draft remains pending human review",
      "environment": "local",
      "assertion": {
        "type": "json_pointer_equals",
        "path": "draft.json",
        "pointer": "/status",
        "value": "DRAFT_REQUIRES_REVIEW"
      }
    },
    {
      "id": "not-sent",
      "expected": "draft is not externally sent",
      "environment": "local",
      "assertion": {
        "type": "json_pointer_equals",
        "path": "draft.json",
        "pointer": "/sent",
        "value": false
      }
    },
    {
      "id": "visible-review",
      "expected": "plain text shows review status",
      "environment": "local",
      "assertion": {
        "type": "text_contains",
        "path": "draft.txt",
        "text": "待人工审核"
      }
    }
  ]
}
