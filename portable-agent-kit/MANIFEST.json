{
  "package": "portable-solo-delivery-kit",
  "version": "0.2.0",
  "protocol_envelope": "aap/0.1",
  "state_version": 2,
  "language": "Python 3.9+, standard library",
  "entrypoints": {
    "core": "core/state_machine.py",
    "local_session_cli": "scripts/session.py",
    "example_adapter": "adapters/example_adapter.py (in-memory demo only)",
    "weak_agent_prompt": "SYSTEM_PROMPT.md",
    "conformance": "tests/",
    "skill_exporter": "../scripts/export_skill.py"
  },
  "platform_integrations": {
    "cursor": "instructions only; host loading unverified",
    "deepseek-harness": "instructions only; host loading unverified",
    "kimi-code": "instructions only; host loading unverified",
    "generic": "instructions only; host loading unverified"
  },
  "local_runtime_status": "CLI and bounded artifact checks are local-only; external and platform actions are not implemented",
  "model_provider": "agnostic",
  "codex_default_execution": true,
  "scheduler": "none",
  "export_status": "independent Skill bundle generated by scripts/export_skill.py; target platform loading must be verified by that host"
}
