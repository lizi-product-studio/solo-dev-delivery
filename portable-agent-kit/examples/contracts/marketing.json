{
  "owner": "host/main",
  "authorization_ref": "isolated-example-only",
  "candidate": "example-v1",
  "excluded": [
    "external actions",
    "production"
  ],
  "policy": {
    "workspace_write": false,
    "ux_required": false,
    "external_actions": false
  },
  "id": "EX-marketing",
  "domain": "marketing-planning",
  "goal": "Prepare a budget draft from approved cost inputs without launching a campaign.",
  "scope": [
    "plan.json"
  ],
  "inputs": [
    "costs.csv"
  ],
  "acceptance": [
    {
      "id": "AC1",
      "expected": "Plan budget equals approved cost sum.",
      "environment": "local-artifact",
      "probe": {
        "type": "csv.reconcile",
        "path": "plan.json",
        "pointer": [
          "budget"
        ],
        "source": "costs.csv",
        "column": "cost"
      }
    },
    {
      "id": "AC2",
      "expected": "The draft preserves the approved no-spend boundary.",
      "environment": "local-artifact",
      "probe": {
        "type": "json.value",
        "path": "plan.json",
        "pointer": [
          "execution_status"
        ],
        "expected": "draft_only"
      }
    },
    {
      "id": "AC3",
      "expected": "A domain reviewer must assess the audience and channel assumptions before actual launch.",
      "environment": "independent-domain-review",
      "probe": {
        "type": "host.review",
        "path": "plan.json"
      }
    }
  ]
}
