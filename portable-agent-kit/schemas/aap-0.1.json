{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/solo-delivery/aap-0.1.json",
  "title": "AAP-0.1 request envelope with Solo Delivery state gates 0.2",
  "description": "The wire envelope remains aap/0.1. State version 2, host-verified evidence, reconcile, and resolve_finding are 0.2 gate semantics; this schema does not prove platform support.",
  "type": "object",
  "required": ["protocol", "request_id", "op", "task_id", "revision", "contract_hash", "candidate", "idempotency_key"],
  "properties": {
    "protocol": {"const": "aap/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "op": {"enum": ["probe", "start", "observe", "tool_result", "evidence", "reconcile", "open_finding", "resolve_finding", "checkpoint", "pause", "resume", "phase", "finish", "cancel"]},
    "task_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "candidate": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": true
}
